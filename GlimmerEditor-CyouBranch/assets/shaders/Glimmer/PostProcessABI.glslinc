#ifndef GLIMMER_POST_PROCESS_ABI
#define GLIMMER_POST_PROCESS_ABI
#define GLIMMER_POST_PROCESS_ABI_VERSION 2

layout(location = 0) out vec4 o_Color;
layout(location = 0) in vec2 v_TexCoord;

uniform sampler2D u_SceneTexture;
uniform sampler2D u_SceneDepth;
uniform sampler2D u_SceneNormal;
uniform sampler2D u_SceneVelocity;
uniform sampler2D u_HistoryTexture;
uniform vec2 u_Resolution;
uniform float u_Time;
uniform int u_HasCamera;
uniform int u_HasNormal;
uniform int u_HasVelocity;
uniform int u_HistoryValid;
uniform vec3 u_CameraPosition;
uniform mat4 u_InverseViewProjection;

struct GlimmerPostProcessInput
{
    vec2 UV;
    vec2 Resolution;
    vec2 TexelSize;
    float Time;
    vec4 SceneColor;
    float SceneDepth;
    vec3 SceneNormal;
    float SceneNormalValidity;
    vec2 Velocity;
    vec4 HistoryColor;
    bool HasCamera;
    bool HasNormal;
    bool HasVelocity;
    bool HistoryValid;
    vec3 CameraPosition;
    mat4 InverseViewProjection;
};

vec4 GlimmerSampleScene(vec2 uv)
{
    return texture(u_SceneTexture, uv);
}

float GlimmerSampleDepth(vec2 uv)
{
    return texture(u_SceneDepth, uv).r;
}

vec4 GlimmerSampleEncodedNormal(vec2 uv)
{
    return texture(u_SceneNormal, uv);
}

vec3 GlimmerSampleNormal(vec2 uv)
{
    vec4 encoded = GlimmerSampleEncodedNormal(uv);
    return encoded.a > 0.0
        ? normalize(encoded.xyz * 2.0 - 1.0)
        : vec3(0.0);
}

float GlimmerSampleNormalValidity(vec2 uv)
{
    return texture(u_SceneNormal, uv).a;
}

vec2 GlimmerSampleVelocity(vec2 uv)
{
    return texture(u_SceneVelocity, uv).rg;
}

vec4 GlimmerSampleHistory(vec2 uv)
{
    return texture(u_HistoryTexture, clamp(uv, vec2(0.0), vec2(1.0)));
}

vec3 GlimmerReconstructWorldPosition(vec2 uv, float depth)
{
    vec4 clipPosition = vec4(
        uv * 2.0 - 1.0,
        depth * 2.0 - 1.0,
        1.0);
    vec4 worldPosition = u_InverseViewProjection * clipPosition;
    float safeW = abs(worldPosition.w) > 0.000001
        ? worldPosition.w
        : (worldPosition.w < 0.0 ? -0.000001 : 0.000001);
    return worldPosition.xyz / safeW;
}

vec4 GlimmerPostProcess(GlimmerPostProcessInput inputData);

void main()
{
    vec2 safeResolution = max(u_Resolution, vec2(1.0));
    GlimmerPostProcessInput inputData;
    inputData.UV = v_TexCoord;
    inputData.Resolution = safeResolution;
    inputData.TexelSize = 1.0 / safeResolution;
    inputData.Time = u_Time;
    inputData.SceneColor = GlimmerSampleScene(v_TexCoord);
    inputData.SceneDepth = GlimmerSampleDepth(v_TexCoord);
    vec4 encodedNormal = GlimmerSampleEncodedNormal(v_TexCoord);
    inputData.SceneNormalValidity = encodedNormal.a;
    inputData.SceneNormal = encodedNormal.a > 0.0
        ? normalize(encodedNormal.xyz * 2.0 - 1.0)
        : vec3(0.0);
    inputData.Velocity = GlimmerSampleVelocity(v_TexCoord);
    inputData.HistoryColor = GlimmerSampleHistory(v_TexCoord);
    inputData.HasCamera = u_HasCamera != 0;
    inputData.HasNormal = u_HasNormal != 0;
    inputData.HasVelocity = u_HasVelocity != 0;
    inputData.HistoryValid = u_HistoryValid != 0;
    inputData.CameraPosition = u_CameraPosition;
    inputData.InverseViewProjection = u_InverseViewProjection;
    o_Color = GlimmerPostProcess(inputData);
}

#endif
