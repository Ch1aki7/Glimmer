#ifndef GLIMMER_WATER_SAMPLING
#define GLIMMER_WATER_SAMPLING
#include <Glimmer/TerrainSampling.glslinc>
uniform int u_SmoothSampling;
vec4 waterFinite(vec4 v) { return vec4(isnan(v.x)||isinf(v.x)?0:v.x, isnan(v.y)||isinf(v.y)?0:v.y,
    isnan(v.z)||isinf(v.z)?0:v.z, isnan(v.w)||isinf(v.w)?0:v.w); }
// localUV remains normalized local XZ through both stages; each field maps its own dimensions.
vec4 waterTexelField(sampler2D field, vec2 uv) {
    if(u_SmoothSampling==0) return waterFinite(textureLod(field,uv,0));
    ivec2 size=textureSize(field,0); vec2 p=clamp(uv*vec2(size)-0.5,vec2(0),vec2(size-1));
    ivec2 a=ivec2(floor(p)), b=min(a+1,size-1); vec2 f=fract(p);
    return mix(mix(waterFinite(texelFetch(field,a,0)),waterFinite(texelFetch(field,ivec2(b.x,a.y),0)),f.x),
        mix(waterFinite(texelFetch(field,ivec2(a.x,b.y),0)),waterFinite(texelFetch(field,b,0)),f.x),f.y);
}
vec4 waterField(sampler2D field, vec2 localUV) {
    return waterTexelField(field,GlimmerTerrainTextureUV(field,localUV));
}
#endif
