#ifndef GLIMMER_TERRAIN_SAMPLING
#define GLIMMER_TERRAIN_SAMPLING

uniform int u_TerrainDataVersion;

// Convert normalized local X/Z to texel-center UV for endpoint-node fields.
vec2 GlimmerTerrainTextureUV(sampler2D field, vec2 localUV)
{
	if (u_TerrainDataVersion < 2) return localUV;
	vec2 size = vec2(textureSize(field, 0));
	return (clamp(localUV, vec2(0.0), vec2(1.0)) * (size - 1.0) + 0.5) / size;
}
#endif
