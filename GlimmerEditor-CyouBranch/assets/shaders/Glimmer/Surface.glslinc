#ifndef GLIMMER_SURFACE
#define GLIMMER_SURFACE

#include <Glimmer/ForwardFragmentABI.glslinc>

struct GlimmerSurface
{
    vec3 Albedo;
    vec3 Normal;
    vec3 ViewDirection;
    float AmbientOcclusion;
    float Alpha;
};

GlimmerSurface GlimmerResolveSurface()
{
    vec4 sampledColor = u_HasBaseColorTexture != 0
        ? texture(u_BaseColorTexture, v_TexCoord * u_TilingFactor)
        : vec4(1.0);
    GlimmerSurface surface;
    surface.Albedo = pow(max(u_BaseColor.rgb, vec3(0.0)), vec3(2.2))
        * sampledColor.rgb;
    surface.Alpha = clamp(u_BaseColor.a * sampledColor.a, 0.0, 1.0);
    if (u_AlphaMode == 1 && surface.Alpha < u_AlphaCutoff)
        discard;
    if (u_AlphaMode == 2 && surface.Alpha <= (1.0 / 255.0))
        discard;

    surface.Normal = normalize(v_WorldNormal);
    if (u_HasNormalTexture != 0)
    {
        vec3 tangent = normalize(v_WorldTangent
            - surface.Normal * dot(v_WorldTangent, surface.Normal));
        vec3 bitangent = normalize(cross(surface.Normal, tangent));
        vec3 tangentNormal = texture(
            u_NormalTexture, v_TexCoord * u_TilingFactor).xyz * 2.0 - 1.0;
        tangentNormal.xy *= clamp(u_NormalScale, 0.0, 2.0);
        surface.Normal = normalize(mat3(tangent, bitangent, surface.Normal)
            * normalize(tangentNormal));
    }
    surface.ViewDirection = normalize(u_CameraPos - v_WorldPosition);
    surface.AmbientOcclusion = 1.0;
    if (u_HasAOTexture != 0)
    {
        float sampledAO = texture(
            u_AOTexture, v_TexCoord * u_TilingFactor).r;
        surface.AmbientOcclusion = mix(
            1.0, sampledAO, clamp(u_AOStrength, 0.0, 1.0));
    }
    return surface;
}

void GlimmerWriteColor(vec3 linearColor, float alpha)
{
    o_Color = vec4(max(linearColor, vec3(0.0)),
        u_AlphaMode == 0 ? 1.0 : alpha);
    o_EntityID = v_EntityID;
}

#endif
