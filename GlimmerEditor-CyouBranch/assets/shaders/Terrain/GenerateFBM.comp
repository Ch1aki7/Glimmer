#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(r32f, binding = 0) writeonly uniform image2D u_Output;

uniform int u_Seed;
uniform int u_Octaves;
uniform int u_Preset;
uniform int u_SynthesisVersion;
uniform float u_Frequency;
uniform float u_WorldFrequencyScale;
uniform float u_Lacunarity;
uniform float u_Persistence;
uniform float u_DomainWarp;
uniform float u_RidgeStrength;
uniform float u_ContinentScale;
uniform float u_ErosionStrength;
uniform float u_DetailStrength;
uniform float u_MountainDirection;
uniform float u_MountainWidth;
uniform float u_PlateauStrength;
uniform float u_GeologyBlend;
uniform float u_GeologyScale;
uniform float u_RiftStrength;
uniform float u_TrendStrength;
uniform vec2 u_Offset;

uint Hash(uint value)
{
	value ^= value >> 16;
	value *= 0x7feb352du;
	value ^= value >> 15;
	value *= 0x846ca68bu;
	value ^= value >> 16;
	return value;
}

float Random(ivec2 coordinate)
{
	uint x = uint(coordinate.x);
	uint y = uint(coordinate.y);
	uint seed = uint(u_Seed);
	return float(Hash(x ^ Hash(y ^ Hash(seed)))) / 4294967295.0;
}

float RandomSalted(ivec2 coordinate, uint salt)
{
	uint x = uint(coordinate.x);
	uint y = uint(coordinate.y);
	return float(Hash(x ^ Hash(y ^ Hash(uint(u_Seed) + salt))))
		/ 4294967295.0;
}

vec2 Gradient(ivec2 coordinate)
{
	float angle = Random(coordinate) * 6.28318530718;
	return vec2(cos(angle), sin(angle));
}

float GradientNoise(vec2 position)
{
	ivec2 cell = ivec2(floor(position));
	vec2 fraction = fract(position);
	vec2 fade = fraction * fraction * fraction
		* (fraction * (fraction * 6.0 - 15.0) + 10.0);

	float n00 = dot(Gradient(cell), fraction);
	float n10 = dot(Gradient(cell + ivec2(1, 0)), fraction - vec2(1.0, 0.0));
	float n01 = dot(Gradient(cell + ivec2(0, 1)), fraction - vec2(0.0, 1.0));
	float n11 = dot(Gradient(cell + ivec2(1, 1)), fraction - vec2(1.0));

	return mix(mix(n00, n10, fade.x), mix(n01, n11, fade.x), fade.y) * 0.7071 + 0.5;
}

float FBM(vec2 position)
{
	float value = 0.0;
	float amplitude = 1.0;
	float amplitudeSum = 0.0;
	float frequency = 1.0;

	for (int octave = 0; octave < min(u_Octaves, 12); ++octave)
	{
		value += GradientNoise(position * frequency) * amplitude;
		amplitudeSum += amplitude;
		position = mat2(0.80, -0.60, 0.60, 0.80) * position + vec2(13.17, 7.31);
		frequency *= u_Lacunarity;
		amplitude *= u_Persistence;
	}

	return amplitudeSum > 0.0 ? value / amplitudeSum : 0.0;
}

float RidgedFBM(vec2 position)
{
	float value = 0.0;
	float amplitude = 0.5;
	float amplitudeSum = 0.0;
	float previous = 1.0;

	for (int octave = 0; octave < min(u_Octaves, 10); ++octave)
	{
		float ridge = 1.0 - abs(GradientNoise(position) * 2.0 - 1.0);
		ridge *= ridge;
		ridge *= previous;
		previous = clamp(ridge * 1.8, 0.0, 1.0);
		value += ridge * amplitude;
		amplitudeSum += amplitude;
		position = mat2(0.80, -0.60, 0.60, 0.80) * position * u_Lacunarity
			+ vec2(5.23, 17.71);
		amplitude *= u_Persistence;
	}

	return amplitudeSum > 0.0 ? value / amplitudeSum : 0.0;
}

mat2 Rotation(float angle)
{
	float cosine = cos(angle);
	float sine = sin(angle);
	return mat2(cosine, -sine, sine, cosine);
}

float WorleyDistance(vec2 position)
{
	ivec2 cell = ivec2(floor(position));
	vec2 fraction = fract(position);
	float minimumDistance = 2.0;
	for (int y = -1; y <= 1; ++y)
	{
		for (int x = -1; x <= 1; ++x)
		{
			ivec2 offset = ivec2(x, y);
			ivec2 neighbour = cell + offset;
			vec2 feature = vec2(
				RandomSalted(neighbour, 0x68bc21ebu),
				RandomSalted(neighbour, 0x02e5be93u));
			minimumDistance = min(minimumDistance,
				length(vec2(offset) + feature - fraction));
		}
	}
	return clamp(minimumDistance / 1.41421356, 0.0, 1.0);
}

// The conditional synthesis limits octave wavelength to the height texture's
// sampling density. The legacy functions above remain unchanged for old scenes.
float FilteredFBM(vec2 position, float pixelFootprint)
{
	float sum = 0.0;
	float weightSum = 0.0;
	float amplitude = 1.0;
	float frequency = 1.0;
	for (int octave = 0; octave < min(u_Octaves, 12); ++octave)
	{
		float weight = 1.0 - smoothstep(0.25, 0.48,
			pixelFootprint * frequency);
		if (weight <= 0.0) break;
		sum += GradientNoise(position * frequency) * amplitude * weight;
		weightSum += amplitude * weight;
		position = mat2(0.80, -0.60, 0.60, 0.80) * position
			+ vec2(13.17, 7.31);
		frequency *= u_Lacunarity;
		amplitude *= u_Persistence;
	}
	return weightSum > 0.0 ? sum / weightSum : 0.5;
}

float FilteredRidges(vec2 position, float pixelFootprint)
{
	float sum = 0.0;
	float weightSum = 0.0;
	float amplitude = 0.5;
	float previous = 1.0;
	for (int octave = 0; octave < min(u_Octaves, 10); ++octave)
	{
		float weight = 1.0 - smoothstep(0.25, 0.48, pixelFootprint);
		if (weight <= 0.0) break;
		float ridge = 1.0 - abs(GradientNoise(position) * 2.0 - 1.0);
		ridge *= ridge * previous;
		previous = clamp(ridge * 1.8, 0.0, 1.0);
		sum += ridge * amplitude * weight;
		weightSum += amplitude * weight;
		position = mat2(0.80, -0.60, 0.60, 0.80) * position
			* u_Lacunarity + vec2(5.23, 17.71);
		pixelFootprint *= u_Lacunarity;
		amplitude *= u_Persistence;
	}
	return weightSum > 0.0 ? sum / weightSum : 0.0;
}

float ConditionalHeight(vec2 uv, vec2 position, ivec2 size)
{
	float pixelFootprint = u_Frequency * u_WorldFrequencyScale
		/ float(min(size.x, size.y));
	vec2 warp = vec2(
		FBM(position * 0.33 + vec2(17.13, 3.71)),
		FBM(position * 0.33 + vec2(5.37, 29.41))) - 0.5;
	vec2 p = position + warp * (u_DomainWarp * 0.45);
	vec2 oriented = Rotation(u_MountainDirection) * p;
	float mountainWidth = clamp(u_MountainWidth, 0.05, 1.0);
	vec2 beltScale = vec2(mix(0.20, 0.62, mountainWidth),
		mix(1.85, 0.95, mountainWidth));

	// Broad land mass and elongated belts decide where mountains can exist.
	float region = FBM(p * max(u_ContinentScale * 0.7, 0.035)
		+ vec2(41.7, 9.2));
	float land = smoothstep(0.35, 0.66, region);
	float belt = FBM(oriented * beltScale + vec2(73.4, 31.6));
	float mountainMask = land * smoothstep(0.43, 0.65, belt);
	float hillNoise = FilteredFBM(p * 0.8 + vec2(3.1, 19.7),
		pixelFootprint * 0.8);
	vec2 ridgeScale = vec2(beltScale.x * 2.1, beltScale.y * 1.75);
	float ridge = FilteredRidges(oriented * ridgeScale
		+ vec2(27.1, 8.7), pixelFootprint * max(ridgeScale.x, ridgeScale.y));
	float relief = 0.10 + land * 0.19
		+ (hillNoise - 0.5) * mix(0.08, 0.19, land);
	float mountain = mountainMask * (0.08 + 0.50 * ridge)
		* clamp(u_RidgeStrength, 0.0, 1.0);

	// Geological cells modulate rock relief only inside mountain regions.
	if (u_GeologyBlend > 0.0)
	{
		float cells = 1.0 - WorleyDistance(p * max(u_GeologyScale, 0.25)
			+ vec2(7.3, 31.9));
		mountain += mountainMask * (cells - 0.5)
			* (u_GeologyBlend * 0.17);
		float rift = FilteredFBM(p * max(u_GeologyScale, 0.25)
			+ vec2(113.7, 47.3), pixelFootprint * max(u_GeologyScale, 0.25));
		mountain -= mountainMask * pow(1.0 - abs(rift * 2.0 - 1.0), 8.0)
			* u_RiftStrength * u_GeologyBlend;
	}
	float height = relief + mountain;

	// The valley signal is conditional on mountainous terrain. It is a
	// shape cue, not a water-flow or sediment transport simulation.
	float valleyNoise = GradientNoise(oriented * vec2(0.8, 2.7)
		+ vec2(97.1, 43.2));
	float valley = pow(1.0 - abs(valleyNoise * 2.0 - 1.0), 7.0);
	height -= valley * mountainMask * u_ErosionStrength
		* (u_Preset == 5 ? 0.60 : 0.32);

	float detail = FilteredFBM(p * 3.6 + vec2(7.7, 61.3),
		pixelFootprint * 3.6) - 0.5;
	height += detail * u_DetailStrength
		* (0.12 + smoothstep(0.27, 0.58, height) * 0.88);
	height += mountainMask * u_TrendStrength
		* (FilteredFBM(oriented * 0.22 + vec2(151.1, 23.7),
			pixelFootprint * 0.22) - 0.5);

	if (u_Preset == 2)
	{
		float terraced = floor(height * 6.0 + 0.5) / 6.0;
		height = mix(height, terraced + (height - terraced) * 0.2,
			clamp(u_PlateauStrength, 0.0, 1.0));
	}
	else if (u_Preset == 3)
		height = 0.09 + land * 0.18 + (hillNoise - 0.5) * 0.27
			+ detail * u_DetailStrength * 0.25;
	else if (u_Preset == 4)
	{
		// Radius is measured in 256-unit terrain coordinates, not map UV.
		float radial = length((uv - 0.5) * u_WorldFrequencyScale
			+ warp * 0.10);
		float cone = 1.0 - smoothstep(0.06, 0.62, radial);
		float crater = exp(-pow((radial - 0.12) / 0.045, 2.0));
		height = max(height * 0.35, 0.06 + cone * 0.72
			- crater * 0.35 + detail * 0.05);
	}
	return clamp(height, 0.0, 1.0);
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(u_Output);
	if (any(greaterThanEqual(pixel, size)))
		return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	vec2 position = ((uv - 0.5) * u_WorldFrequencyScale + u_Offset)
		* u_Frequency;
	if (u_SynthesisVersion >= 2)
	{
		imageStore(u_Output, pixel, vec4(ConditionalHeight(uv, position, size)));
		return;
	}

	vec2 warp = vec2(
		FBM(position * 0.45 + vec2(17.13, 3.71)),
		FBM(position * 0.45 + vec2(5.37, 29.41))) - 0.5;
	vec2 warpedPosition = position + warp * u_DomainWarp;

	float continentNoise = FBM(position * max(u_ContinentScale, 0.01) + vec2(41.7, 9.2));
	float continental = smoothstep(0.36, 0.68, continentNoise);
	float broadLand = smoothstep(0.18, 0.82, continentNoise);

	float rollingHills = FBM(warpedPosition * 0.75 + vec2(3.1, 19.7));
	float mountainMask = smoothstep(
		0.42,
		0.70,
		FBM(position * 0.28 + vec2(73.4, 31.6)));
	float ridges = RidgedFBM(warpedPosition * 1.15 + vec2(11.3, 2.8));
	ridges = pow(clamp(ridges, 0.0, 1.0), 1.35);

	// Anisotropic ridged noise produces long connected mountain chains instead
	// of distributing equally sharp peaks over the complete height field.
	vec2 chainPosition = Rotation(u_MountainDirection) * warpedPosition;
	float chainWidth = clamp(u_MountainWidth, 0.05, 1.0);
	vec2 chainScale = vec2(mix(0.22, 0.62, chainWidth), mix(3.2, 1.25, chainWidth));
	float primaryChain = RidgedFBM(chainPosition * chainScale + vec2(27.1, 8.7));
	vec2 secondaryPosition = Rotation(u_MountainDirection + 1.07) * warpedPosition;
	float secondaryChain = RidgedFBM(
		secondaryPosition * vec2(chainScale.x * 0.8, chainScale.y * 0.72)
		+ vec2(61.3, 17.9));
	float rangeRidges = pow(clamp(max(primaryChain, secondaryChain * 0.72), 0.0, 1.0), 1.6);

	float channelNoise = 1.0 - abs(
		FBM(warpedPosition * 1.9 + vec2(97.1, 43.2)) * 2.0 - 1.0);
	float channels = pow(clamp(channelNoise, 0.0, 1.0), 6.0);
	float fineDetail = FBM(warpedPosition * 4.5 + vec2(7.7, 61.3)) - 0.5;

	float ridgeSignal = u_Preset == 3 ? ridges * 0.25
		: mix(ridges, rangeRidges, u_Preset == 0 ? 0.55 : 0.82);
	float foothills = mix(rollingHills * 0.20, ridgeSignal * 0.38, mountainMask);
	float mountains = ridgeSignal * mountainMask * clamp(u_RidgeStrength, 0.0, 1.0);
	float height = 0.04 + broadLand * 0.20 + continental * foothills + mountains * 0.42;
	height += fineDetail * u_DetailStrength * smoothstep(0.12, 0.45, height);
	height -= channels * u_ErosionStrength * continental * (0.30 + mountainMask * 0.70);

	// Optional geological shaping adapted from the tmpTerrain prototype.
	// A zero blend preserves the original Glimmer generator exactly.
	if (u_GeologyBlend > 0.0)
	{
		float geologyScale = max(u_GeologyScale, 0.25);
		float steepRegion = smoothstep(0.42, 0.70,
			FBM(position * 0.34 + vec2(19.7, 83.1)));
		float cellular = 1.0 - WorleyDistance(
			warpedPosition * geologyScale + vec2(7.3, 31.9));
		float cellularRelief = (cellular - 0.52)
			* (0.10 + steepRegion * 0.22) * continental;

		float riftNoise = FBM(
			warpedPosition * (geologyScale * 1.9) + vec2(113.7, 47.3));
		float riftLine = 1.0 - abs(riftNoise * 2.0 - 1.0);
		float rift = pow(clamp(riftLine, 0.0, 1.0), 8.0)
			* (1.0 - steepRegion * 0.35) * continental;

		vec2 trendPosition = Rotation(u_MountainDirection)
			* position * 0.22 + vec2(151.1, 23.7);
		float trend = (FBM(trendPosition) - 0.5)
			* smoothstep(0.18, 0.72, broadLand);

		float geologicalHeight = height + cellularRelief
			- rift * u_RiftStrength + trend * u_TrendStrength;
		height = mix(height, geologicalHeight,
			clamp(u_GeologyBlend, 0.0, 1.0));
	}

	if (u_Preset == 2)
	{
		float terraceCount = 5.0;
		float terraced = floor(height * terraceCount + 0.5) / terraceCount;
		height = mix(height, smoothstep(terraced - 0.035, terraced + 0.035, height)
			* (1.0 / terraceCount) + terraced - 0.5 / terraceCount,
			clamp(u_PlateauStrength, 0.0, 1.0));
	}
	else if (u_Preset == 3)
	{
		height = 0.08 + broadLand * (0.16 + rollingHills * 0.38)
			+ fineDetail * u_DetailStrength;
	}
	else if (u_Preset == 4)
	{
		vec2 craterOffset = warp * 0.10;
		float radial = length((uv - 0.5) + craterOffset);
		float cone = smoothstep(0.52, 0.07, radial);
		float crater = exp(-pow((radial - 0.085) / 0.035, 2.0));
		height = max(height * 0.55, 0.06 + cone * 0.78 - crater * 0.42
			+ fineDetail * 0.08);
	}
	else if (u_Preset == 5)
	{
		height -= channels * clamp(u_ErosionStrength * 1.45, 0.0, 0.65)
			* smoothstep(0.12, 0.65, height);
	}

	// Preserve broad plains while giving mountain ranges additional relief.
	height = pow(clamp(height, 0.0, 1.0), 1.18);
	imageStore(u_Output, pixel, vec4(height));
}
