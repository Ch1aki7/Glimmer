#version 450 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(r32f, binding = 0) uniform readonly image2D u_Water;
layout(rgba16f, binding = 1) uniform readonly image2D u_Velocity;
layout(r32f, binding = 2) uniform readonly image2D u_Sediment;
layout(r32f, binding = 3) uniform writeonly image2D u_Capacity;
layout(r32f, binding = 4) uniform writeonly image2D u_Saturation;

uniform float u_CapacityScale;

const float CapacityEpsilon = 1.0e-6;
const float MaximumSaturation = 1000.0;

void main()
{
	ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
	ivec2 dimensions = imageSize(u_Water);
	if (any(greaterThanEqual(cell, dimensions)))
		return;

	float waterDepth = max(imageLoad(u_Water, cell).r, 0.0);
	float speed = length(imageLoad(u_Velocity, cell).xy);
	float sediment = max(imageLoad(u_Sediment, cell).r, 0.0);
	float capacity = max(u_CapacityScale, 0.0) * waterDepth * speed;
	float saturation = capacity > CapacityEpsilon
		? min(sediment / capacity, MaximumSaturation)
		: (sediment > CapacityEpsilon ? MaximumSaturation : 0.0);

	imageStore(u_Capacity, cell, vec4(capacity, 0.0, 0.0, 0.0));
	imageStore(u_Saturation, cell, vec4(saturation, 0.0, 0.0, 0.0));
}
